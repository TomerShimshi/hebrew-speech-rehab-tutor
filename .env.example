GEMINI_API_KEY=

# Sign-in (sub-plan 03). Comma-separated Google emails. Kept here, never in the repo.
ALLOWED_EMAILS=
CAREGIVER_EMAILS=

# Firebase web config (Firebase console -> Project settings -> Your apps -> Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Patient profiles are per account (sub-plan 15), kept with the account's data: upload one on
# the caregiver page (the account's "Profile" card). Not configured here.

# The Simon games app (sub-plan 06). Upstash console -> your DB -> REST API:
# the URL and the READ-ONLY token (not the regular one).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_READONLY_TOKEN=
SIMON_APP_URL=
# account email -> Simon profile, comma-separated: dad@x.com=efraim,me@x.com=tomer
SIMON_PROFILES=

# Research sub-agent (sub-plan 07): free Tavily key from https://app.tavily.com (no card).
# Without it, the plan builder just skips research.
TAVILY_API_KEY=

# Daily reminder notifications (sub-plan 11): Web Push keys. Generate a pair once (see
# docs/plans/11-whatsapp-reminder.md); the private key goes to Secret Manager via setup_gcp.sh.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
